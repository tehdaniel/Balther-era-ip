{
  "config": {
    "step": {
      "user": {
        "title": "Balter ERA IP",
        "description": "Log in with a Balter ERA IP app account. A separate account for Home Assistant is recommended, otherwise the phone app may be logged out.",
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]",
          "host": "Server",
          "port": "[%key:common::config_flow::data::port%]"
        },
        "data_description": {
          "host": "Balter cloud server. Only change this if Balter moves its server.",
          "port": "Port of the account server."
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "The password for {username} was rejected.",
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "no_devices": "No door system is linked to this account.",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    }
  },
  "entity": {
    "button": {
      "door_1": {
        "name": "Open door 1"
      },
      "door_2": {
        "name": "Open door 2"
      },
      "refresh_image": {
        "name": "Refresh camera image"
      }
    },
    "event": {
      "doorbell": {
        "name": "Doorbell",
        "state_attributes": {
          "event_type": {
            "state": {
              "ring": "Ring"
            }
          }
        }
      }
    }
  },
  "exceptions": {
    "open_failed": {
      "message": "Opening the door failed: {error}"
    },
    "image_failed": {
      "message": "Fetching the camera image failed: {error}"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Doorbell",
        "description": "Choose where doorbell rings come from. Recommended: a sensor wired to the indoor monitor, e.g. a Shelly input.",
        "data": {
          "ring_entity": "Doorbell sensor",
          "cloud_ring": "Also listen to the Balter cloud (experimental)"
        },
        "data_description": {
          "ring_entity": "Binary sensor, switch, input boolean (rings when it turns on) or event entity (rings on every event).",
          "cloud_ring": "Keeps a connection to the Balter cloud open and registers for push notifications. Did not deliver rings in tests."
        }
      }
    }
  }
}
